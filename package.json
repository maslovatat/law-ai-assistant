{
  "name": "law-ai-assistant-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Демонстрационный frontend-прототип платформы сопровождения юридических дел",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b && tsc -p tsconfig.scripts.json",
    "test": "npm run test:flow && npm run test:render",
    "test:flow": "esbuild scripts/verify-flow.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-flow.mjs --log-level=warning && node node_modules/.tmp/verify-flow.mjs",
    "test:render": "esbuild scripts/verify-render.tsx --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-render.cjs --log-level=warning --jsx=automatic && node node_modules/.tmp/verify-render.cjs",
    "deploy": "npm run build && npx --yes gh-pages -d dist"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0"
  }
}