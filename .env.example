# AI provider: demo | gemini | groq | ollama. Copy this file to .env (setup.bat does it).
AI_PROVIDER=demo

# Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (optional, local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Token saving limits
AI_MAX_OUTPUT_TOKENS=700
AI_HISTORY_MESSAGES=6

# App
MAX_UPLOAD_MB=10
SESSION_DAYS=7
DEMO_DELIVERY_STEP_SECONDS=6
# Path to tesseract.exe if not in PATH
TESSERACT_CMD=
